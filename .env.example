# «Инспектор ИИ» — настройки развёртывания.
#   cp .env.example .env     и поправьте значения; .env в git не попадает.
# Порядок значений: переменные оболочки > .env > значения по умолчанию (docker-compose.yml, inspector/config.py).
# Закомментированная строка = действует значение по умолчанию, указанное в ней.
# Пустое значение числовой настройки не допускается (ошибка при старте) — такую строку закомментируйте.

# ═════ 1. Модели: адреса для api/worker (OpenAI-совместимый API) ═════
# Одна Qwen3.8-27B на всё: класс страницы, извлечение, судья, перечитывание сканов.
# Текст сканов даёт RapidOCR (в образе), отобранные для извлечения страницы перечитывает та же модель.
LLM_URL=http://llm:8000/v1
LLM_MODEL=qwen
# пусто -> OCR идёт в LLM_URL / LLM_MODEL
OCR_URL=
OCR_MODEL=
# метка версии моделей в протоколе и реестре (трассируемость); пусто -> из имён моделей и настроек OCR.
# Сменили LLM_MODEL_REPO — поправьте метку. Для запасных весов NVFP4:
#   MODEL_VERSION_LABEL=llm=unsloth/Qwen3.8-27B-NVFP4;ocr=rapidocr-ppocrv5-mobile+reocr:unsloth/Qwen3.8-27B-NVFP4;bbox=rapidocr-ppocrv5-mobile+orient-ab
MODEL_VERSION_LABEL=llm=Qwen/Qwen3.8-27B-FP8;ocr=rapidocr-ppocrv5-mobile+reocr:Qwen/Qwen3.8-27B-FP8;bbox=rapidocr-ppocrv5-mobile+orient-ab

# провайдер API модели
LLM_PROVIDER=vllm
# ключ API модели (vLLM локально — не нужен). Секрет: только в .env
LLM_API_KEY=
# пусто -> как LLM_PROVIDER
OCR_PROVIDER=
# OCR страниц без текстового слоя: rapidocr (текст — RapidOCR) | vlm (модель читает все) | none
# OCR_ENGINE=rapidocr
# при rapidocr: страницы, отобранные для извлечения, перечитывает модель (точный текст значений)
# REOCR_SELECTED=true
# процессов RapidOCR на CPU; 0 — число ядер / 4
# RAPIDOCR_WORKERS=0
# рамки слов на OCR-страницах: rapidocr | none
# BBOX_ENGINE=rapidocr
# RapidOCR на GPU — пул процессов, у каждого свой движок (~5 ГБ видеопамяти); профиль h100: 2 процесса ≈ 11 ГБ рядом с
# Qwen FP8 (~53 ГБ в работе), запас ~12 ГБ. 4 процесса быстрее, но рядом с FP8 не помещаются (оценка ~81 из 81,5 ГБ);
# с весами NVFP4 — можно 4. Текст тот же, что у пула CPU. Нет CUDA для onnxruntime — явная ошибка в журнале и пул CPU.
RAPIDOCR_GPU=true
# RAPIDOCR_GPU_WORKERS=2
# предел памяти onnxruntime на сессию (у процесса их три)
# RAPIDOCR_GPU_MEM_GB=3
# выпрямлять повёрнутые сканы перед RapidOCR (угол — если голоса строк RapidOCR и RapidOrientation согласны)
# RAPIDOCR_ORIENT=true
# извлечение значений: на OCR-страницах вместе с текстом картинка страницы (прироста не дало, выкл.)
# EXTRACT_WITH_IMAGE=false
# параллельных запросов к модели: извлечение/судья, OCR, классификация страниц
# LLM_CONCURRENCY=16
# OCR_CONCURRENCY=32
# CLASSIFY_CONCURRENCY=12
# таймаут одного запроса к модели, с; число попыток
# LLM_TIMEOUT_S=600
# LLM_RETRIES=3
# предел токенов ответа OCR на плитку
# OCR_MAX_TOKENS=4000
# отбор страниц: fused (обучаемая модель F40 + слова названия, inspector/resources/router) | lexical (только слова)
# SELECT_MODE=fused
# сколько страниц-кандидатов отбирать на параметр × стадию
# TOP_K_PAGES=40
# классификатор типа страницы с дообучением на правках разметчиков (вариант 2: LiLT-ruBert + SigLIP2, ~0,74 ГБ,
# без обучающих данных). Уверенные страницы размечает он, неуверенные и первые страницы ИД (нужен заголовок: номер
# акта) — Qwen. Каталог модели на хосте (manifest.json + predict.py); в контейнерах — /models/page-cls. Скачивает его
# scripts/prefetch_models.sh (репозиторий и ревизия — ниже). Каталога нет — тип страницы даёт только Qwen. GPU для
# worker — строка COMPOSE_FILE ниже (раздел 2).
# PAGE_CLASSIFIER_HOST_DIR=./models/page-cls
# PAGE_CLS_MODEL_REPO=wolk1612/inspector-page-cls
# PAGE_CLS_MODEL_REVISION=d55fc9acdf1b327a09a360e61c602cace3cee874
# устройство (auto: cuda, если worker видит GPU) и порог уверенности (0 — порог гибрида из manifest)
# PAGE_CLASSIFIER_DEVICE=auto
# PAGE_CLASSIFIER_MIN_CONF=0
# первые страницы каких файлов всё равно отдавать Qwen: id (ИД и неизвестная стадия) | all | off
# PAGE_CLASSIFIER_FIRST_TO_QWEN=id
# замороженный набор приёмки новых версий (JSONL); пусто — новые версии утверждает ответственный (роль ml)
# PAGE_CLS_ACCEPTANCE=
# приёмка: класс на наборе не ниже прежнего больше чем на столько (0.01 = 1 п. п.)
# RETRAIN_MAX_DROP=0.01

# ═════ 2. Веса и vLLM (профиль h100) ═════
# GPU для worker (классификатор типа страницы рядом с vLLM); без строки worker работает на CPU
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
# кэш Hugging Face на хосте: монтируется в vLLM целиком (в каталогах моделей — симлинки на общие blobs)
HF_HOME=~/.cache/huggingface
# 1 — vLLM не ходит в интернет, веса только из кэша (скачать заранее: scripts/prefetch_models.sh);
# 0 — vLLM докачивает недостающее при старте (долго, может не уложиться в 15 мин проверки готовности)
HF_HUB_OFFLINE=1
# основная модель: FP8 Hopper считает напрямую — вдвое быстрее NVFP4. Запасная — unsloth/Qwen3.8-27B-NVFP4
# (с ней RAPIDOCR_GPU_WORKERS=4 и метка NVFP4 выше)
LLM_MODEL_REPO=Qwen/Qwen3.8-27B-FP8
# память под KV-кэш — абсолютно (GPU стенда может быть общей); суффикс G = ГиБ
LLM_KV_BYTES=16G
# доля GPU, которая должна быть СВОБОДНА при старте движка (проверка vLLM), и одновременных запросов
# LLM_GPU_UTIL=0.60
# LLM_MAX_SEQS=32
# образ vLLM (CUDA 13: драйвер хоста >= 580)
# VLLM_IMAGE=vllm/vllm-openai:v0.29.0
# 1 — прямая совместимость CUDA (cuda-compat 580 в образе) для серверных GPU со старым драйвером (535–575);
# на потребительских (GeForce/RTX) не работает. Не проверено.
# VLLM_ENABLE_CUDA_COMPATIBILITY=0
# сколько worker ждёт ответа моделей при старте (загрузка весов), с; 0 — не ждать
# WAIT_FOR_MODELS_S=1800

# ═════ 3. База данных (Postgres в compose) ═════
POSTGRES_DB=inspector
POSTGRES_USER=inspector
# смените ДО первого запуска (БД запоминает пароль при создании тома); латиница, цифры, дефис —
# без @ : / ? # % и пробелов (пароль подставляется в DATABASE_URL)
POSTGRES_PASSWORD=change-me-db-password
# compose собирает DATABASE_URL из POSTGRES_*; задать явно — для внешней БД. Без Docker пусто -> SQLite в DATA_DIR
# DATABASE_URL=postgresql+psycopg://inspector:change-me-db-password@db:5432/inspector
# резервные копии (служба backup): pg_dump каждые N минут, копии старше N дней удаляются
# BACKUP_INTERVAL_MIN=15
# BACKUP_KEEP_DAYS=30
# каталог хоста для копий (например, сетевой диск); не задан — том inspector_backups
# BACKUP_DIR=/srv/inspector-backups

# ═════ 4. API и безопасность ═════
# адрес и порт api на хосте (127.0.0.1 — только локально, например за обратным прокси с TLS)
API_BIND=0.0.0.0
API_PORT=8080
# ключ подписи JWT (HS256). Пусто или «change-me…» -> при старте создаётся случайный и хранится в томе данных.
# Свой: openssl rand -hex 32
JWT_SECRET=change-me
# срок жизни токена, ч
# JWT_TTL_HOURS=12
# защита входа от перебора: после N неудачных входов пары (логин, IP) за окно, с — 429 с Retry-After;
# успешный вход сбрасывает счёт; счётчик в памяти процесса api. 0 — защита выключена
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_S=300
# демо-учётки (создаются при первом старте, если их нет в БД) — смените
INSPECTOR_PASSWORD=inspector
SUPERVISOR_PASSWORD=supervisor
ADMIN_PASSWORD=admin
ML_PASSWORD=ml
# IP обратного прокси, которому uvicorn верит в X-Forwarded-For/Proto (через запятую; по умолчанию 127.0.0.1)
# FORWARDED_ALLOW_IPS=127.0.0.1

# ═════ 5. Загрузка пакетов ═════
# ТЗ 9.1: 50 МБ на файл, 200 МБ на запрос загрузки
# MAX_FILE_MB=50
# MAX_UPLOAD_MB=200
# каталог хоста с пакетами для импорта с диска сервера (admin, POST /api/v1/processes/{id}/import-local);
# в контейнере он доступен только на чтение как /import. Каталог должен существовать (иначе Docker создаст
# его от root). Не задан — пустой том, импорт с диска не используется.
# IMPORT_DIR=/srv/inspector-import
# манифест организатора JSONL (sha256 -> file_id, stage) — путь ВНУТРИ контейнера, например /import/manifest.jsonl
MANIFEST_PATH=

# ═════ 6. Интеграция с ИАИС РиН (заглушка) ═════
# куда отправлять протокол; по умолчанию — встроенный приёмник-заглушка api
# RIN_URL=http://api:8080/api/v1/mock-rin/receive
# общий токен РиН: отправитель передаёт его в Authorization: Bearer …, заглушка без него отвечает 401. Секрет.
# Пусто -> случайный токен создаётся в томе данных (.rin_token) и общий для api и worker. Свой: openssl rand -hex 32
RIN_TOKEN=
# паузы между повторами отправки, с (ТЗ 9.6: 1, 5, 15 минут)
# RIN_RETRY_DELAYS_S=60,300,900
# 1 — заглушка РиН отвечает 503 (проверка повторов и PENDING_SYNC)
# MOCK_RIN_FAIL=0

# ═════ 7. Служебное ═════
# уровень логов: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# период опроса очереди задач worker'ом, с
# WORKER_POLL_S=2.0
# 1 — собрать образ без интерфейса (заглушка вместо web/dist)
# SKIP_WEB=0
# имя образа api/worker
# INSPECTOR_IMAGE=inspector:latest
# Задаются в docker-compose.yml (в контейнере), здесь — только для запуска без Docker:
#   DATA_DIR=/var/inspector      хранилище: оригиналы, конвертации, кэш разбора по SHA-256, протоколы
#   IMPORT_ROOTS=/import         где admin может импортировать пакеты (через «:»)
#   WEB_DIST=/app/web/dist       собранный интерфейс
